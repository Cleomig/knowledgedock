# KnowledgeDock - Variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` y `.env.production` estan en .gitignore: nunca se suben a git.

# ---------------------------------------------------------------------------
# Proveedor de IA (obligatorio: al menos uno)
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Groq (alternativa) ---
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (alternativa) ---
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_EMBEDDING_MODEL=nomic-ai/nemotron-3-embed-8x22b:free

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Desarrollo local (Docker en el puerto 55432; el 5432 lo ocupa PostgreSQL del sistema):
DATABASE_URL=postgresql://knowledgedock:dev_password_2024@localhost:55432/knowledgedock
# Produccion (Neon): usa .env.production, no este archivo.

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# Secreto de 32+ bytes para firmar sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# URL base publica de la app; localmente http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Archivos (configuracion futura: la app NO usa R2 en la opcion A)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
