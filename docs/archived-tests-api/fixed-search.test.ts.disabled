import { describe, it, expect, vi } from 'vitest'

// Mock global antes de importar
vi.mock('@/lib/db', () => ({
  query: vi.fn(),
  execute: vi.fn()
}))

vi.mock('@/lib/ai', () => ({
  getAiProvider: vi.fn()
}))

// Ahora importamos después de mockear
import { POST } from '@/app/api/search/route'

describe('API: POST /api/search', () => {
  // Necesitamos obtener los mocks después de importar
  let mockQuery: any
  let mockEmbed: any
  
  beforeEach(async () => {
    // Resetear todos los mocks
    vi.resetAllMocks()
    
    // Importar dinámicamente para obtener los mocks frescos
    const db = await import('@/lib/db')
    const ai = await import('@/lib/ai')
    
    mockQuery = db.query
    mockEmbed = vi.fn()
    
    // Configurar el mock de AI
    ai.getAiProvider.mockReturnValue({
      chat: vi.fn(),
      embed: mockEmbed,
      embedBatch: vi.fn(),
      streamChat: vi.fn()
    })
    
    // Configurar valores por defecto
    mockQuery.mockResolvedValue([
      {
        content: 'Contenido del primer chunk',
        ord: 0,
        document_id: 'doc-1',
        title: 'Documento 1',
        similarity: '0.85'
      },
      {
        content: 'Contenido del segundo chunk',
        ord: 1,
        document_id: 'doc-1',
        title: 'Documento 1',
        similarity: '0.75'
      }
    ])
    
    mockEmbed.mockResolvedValue({
      vector: Array.from({ length: 768 }, (_, i) => 0.5)
    })
  })

  it('debería retornar 400 si no hay body', async () => {
    const request = new Request('http://localhost:3000/api/search', {
      method: 'POST'
    })
    
    // Mockear req.json() para lanzar error de parseo
    vi.spyOn(Request.prototype, 'json').mockRejectedValue(new Error('JSON parse error'))
    
    const response = await POST(request)
    
    expect(response.status).toBe(500) // INTERNAL_ERROR cuando JSON falla
    const data = await response.json()
    expect(data.error.code).toBe('INTERNAL_ERROR')
  })

  it('debería retornar 400 si query está vacía', async () => {
    const request = new Request('http://localhost:3000/api/search', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query: '' })
    })
    
    const response = await POST(request)
    
    expect(response.status).toBe(400)
    const data = await response.json()
    expect(data.error.code).toBe('INVALID_REQUEST')
  })

  it('debería retornar resultados de búsqueda exitosa', async () => {
    const request = new Request('http://localhost:3000/api/search', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query: 'test search' })
    })
    
    const response = await POST(request)
    
    expect(response.status).toBe(200)
    const data = await response.json()
    
    expect(data).toHaveProperty('query')
    expect(data.query).toBe('test search')
    expect(data).toHaveProperty('results')
    expect(Array.isArray(data.results)).toBe(true)
    
    // Verificar estructura de cada resultado
    if (data.results.length > 0) {
      data.results.forEach((result: any) => {
        expect(result).toHaveProperty('content')
        expect(result).toHaveProperty('ord')
        expect(result).toHaveProperty('documentId')
        expect(result).toHaveProperty('title')
        expect(result).toHaveProperty('similarity')
      })
    }
  })
})

describe('API: GET /api/documents', () => {
  // Mock global
  vi.mock('@/lib/db', () => ({
    query: vi.fn(),
    execute: vi.fn()
  }))

  // Importar después de mockear
  import('@/app/api/documents/route').then(async (module) => {
    const { GET } = module
    
    it('debería retornar lista de documentos', async () => {
      const response = await GET()
      
      expect(response.status).toBe(200)
      const data = await response.json()
      
      expect(data).toHaveProperty('documents')
      expect(Array.isArray(data.documents)).toBe(true)
    })
  })
})